# HedgeDoc Configuration for Railway
# Copy these variables to your Railway project settings

# Database URL (Railway will provide this automatically when you add PostgreSQL)
CMD_DB_URL=postgres://user:password@host:port/database

# Domain configuration (Railway will provide this)
CMD_DOMAIN=your-app.railway.app
CMD_URL_ADDPORT=false

# Protocol (use https in production)
CMD_PROTOCOL_USESSL=true

# Session secret (generate a random string)
CMD_SESSION_SECRET=changeme_generate_random_string

# Optional: Configure allowed origins
# CMD_ALLOW_ORIGIN=["localhost", "your-app.railway.app"]
